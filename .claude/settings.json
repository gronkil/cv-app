{
  "mcpServers": {
    "playwright": {
      "command": "playwright-mcp",
      "args": [
        "--browser", "chromium",
        "--executable-path", "/opt/pw-browsers/chromium-1194/chrome-linux/chrome",
        "--headless"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
